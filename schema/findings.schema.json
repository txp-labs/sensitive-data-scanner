{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/txp-labs/sensitive-data-scanner/schema/findings.schema.json",
  "title": "Sensitive-data scanner findings, version 1.7",
  "description": "What one scan found in one account and region, or (1.4) in one site of the databases runner, or (1.6) in the Azure subscriptions of one site, or (1.7) in the Google Cloud projects of one site: locations, classes, counts, confidence, offsets and coverage. Never a value. The same object is the detail of a 'Findings v1' EventBridge event, with 'part' and 'parts' added.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "scannerVersion", "specVersion", "runId",
    "startedAt", "finishedAt", "classes", "coverage", "findings", "findingsTotal",
    "findingsTruncated", "totals"
  ],
  "allOf": [
    {
      "description": "An AWS run names its account and region; a databases run (1.4), an Azure run (1.6) and a Google Cloud run (1.7) name their site instead.",
      "if": { "required": ["platform"], "properties": { "platform": { "enum": ["database", "azure", "gcp"] } } },
      "then": { "required": ["site"] },
      "else": { "required": ["account", "region"] }
    }
  ],
  "properties": {
    "schema": { "const": "sensitive-data-scanner.findings" },
    "schemaVersion": { "const": "1.7" },
    "scannerVersion": { "type": "string", "maxLength": 32 },
    "specVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
    "platform": {
      "description": "Where the scanner ran (1.4). Absent: AWS, and the document names its account and region. 'database': the databases-anywhere container; 'azure' (1.6): the Azure scanner, whose findings and stores each name their subscription; 'gcp' (1.7): the Google Cloud scanner, whose findings and stores each name their project. Each names its site instead of an account and region.",
      "enum": ["aws", "database", "azure", "gcp"]
    },
    "site": {
      "description": "The name the customer gave the place a non-AWS runner runs in (SCANNER_SITE): a data center, a cluster (1.4), an Azure management group (1.6), a Google Cloud organization or folder (1.7). Never a host or a connection string.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "account": { "type": "string", "pattern": "^[0-9]{12}$" },
    "region": { "type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "classes": { "type": "array", "items": { "$ref": "#/$defs/class" } },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "findingsTotal": { "type": "integer", "minimum": 0 },
    "findingsTruncated": { "type": "boolean" },
    "totals": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/class" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "discovery": { "$ref": "#/$defs/discovery" },
    "part": { "type": "integer", "minimum": 1 },
    "parts": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "atRestEncryption": {
      "description": "The storage encryption the data sat under, from the store's own configuration (1.5): none, service_managed (a key the service holds: SSE-S3, an AWS owned or AWS managed key, a database's platform encryption), customer_managed_key (the customer's own key, named only by atRestKeyHash), or unknown.",
      "enum": ["none", "service_managed", "customer_managed_key", "unknown"]
    },
    "atRestKeyHash": {
      "description": "The SHA-256 of the customer managed key's id (the part after key/ in its ARN), lower-case hex (1.5). Never the key's id or ARN.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "class": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "storeKind": {
      "description": "A kind of store (1.3: one list for coverage, the run summary and listing errors; each kind after rds is new in 1.3; the databases runner's engines, from postgresql, are new in 1.4, and mysql covers MariaDB; stepfunctions, lambda, xray, codecommit, s3_directory, msk, mq, ecr, sagemaker, neptune_analytics, eventbridge_archive and glacier are new in 1.5; the Azure kinds, from azure_blob, are new in 1.6; the Google Cloud kinds, from gcs, are new in 1.7).",
      "enum": [
        "s3", "cloudwatch_logs", "dynamodb", "glue_table", "rds", "redshift", "opensearch",
        "documentdb", "neptune", "ebs", "backup", "efs", "fsx", "kinesis", "firehose", "sqs",
        "ssm", "secretsmanager", "elasticache", "memorydb", "timestream", "keyspaces",
        "postgresql", "mysql", "sqlserver", "oracle", "mongodb", "snowflake", "databricks",
        "stepfunctions", "lambda", "xray", "codecommit", "s3_directory", "msk", "mq",
        "ecr", "sagemaker", "neptune_analytics", "eventbridge_archive", "glacier",
        "azure_blob", "azure_sql", "azure_sql_mi", "azure_postgresql", "azure_mysql",
        "synapse_sql", "azure_table", "azure_queue", "cosmosdb", "cosmosdb_mongo",
        "log_analytics", "azure_disk_snapshot", "key_vault",
        "gcs", "bigquery", "firestore", "datastore", "spanner", "bigtable", "cloudsql_postgresql", "cloudsql_mysql", "cloudsql_sqlserver",
        "alloydb"
      ]
    },
    "azureSubscription": {
      "description": "An Azure subscription id (1.6), masked like a name.",
      "type": "string",
      "pattern": "^[0-9a-fA-F#]{8}-(?:[0-9a-fA-F#]{4}-){3}[0-9a-fA-F#]{12}$"
    },
    "resourceIdHash": {
      "description": "The SHA-256 of the store's Azure resource ID, lower-cased, as lower-case hex (1.6). Never the ID itself, which names the resource group and the resource.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gcpProject": {
      "description": "A Google Cloud project id (1.7), masked like a key.",
      "type": "string",
      "pattern": "^[a-z0-9#][a-z0-9.:#-]{0,62}$"
    },
    "resourceNameHash": {
      "description": "The SHA-256 of the store's Google Cloud full resource name, exactly as Cloud Asset Inventory gives it (//storage.googleapis.com/<bucket>, //bigquery.googleapis.com/projects/<project>/datasets/<dataset>/tables/<table>), as lower-case hex (1.7). Never the name itself.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maskedName": {
      "description": "A name from the account (bucket, key, log group or stream, DynamoDB key value or attribute path). Any run that could be a card number or an SSN is masked with '#'.",
      "type": "string",
      "maxLength": 1024
    },
    "resource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "bucket", "key", "versionId"],
          "properties": {
            "type": { "const": "s3_object" },
            "bucket": {
              "description": "The bucket name, masked like a key (1.2: '#' may appear).",
              "type": "string",
              "pattern": "^[a-z0-9#][a-z0-9.#-]{1,61}[a-z0-9#]$"
            },
            "key": { "$ref": "#/$defs/maskedName" },
            "versionId": { "type": "string", "maxLength": 1024 },
            "keyMasked": { "const": true },
            "column": {
              "description": "For a table object (Parquet, ORC, Avro, or a catalog table's CSV or JSON): the column the values are in (1.2).",
              "$ref": "#/$defs/maskedName"
            },
            "catalog": {
              "description": "For an object read as part of a Glue Data Catalog table: its database and table (1.2).",
              "type": "object",
              "additionalProperties": false,
              "required": ["database", "table"],
              "properties": {
                "database": { "$ref": "#/$defs/maskedName" },
                "table": { "$ref": "#/$defs/maskedName" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "logGroup", "logStream", "timestamp"],
          "properties": {
            "type": { "const": "log_event" },
            "logGroup": { "$ref": "#/$defs/maskedName" },
            "logStream": { "$ref": "#/$defs/maskedName" },
            "timestamp": { "type": "integer", "minimum": 0 },
            "nameMasked": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "table", "keyHash", "key", "attributePath"],
          "properties": {
            "type": { "const": "dynamodb_item" },
            "table": {
              "description": "The table name, masked like a key (1.2: '#' may appear).",
              "type": "string",
              "pattern": "^[A-Za-z0-9_.#-]{3,255}$"
            },
            "keyHash": {
              "description": "HMAC-SHA256 of the item's key under a salt kept in the scanner's state: stable across runs, never the key.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "key": {
              "description": "The item's key attributes, each value masked like an S3 object key.",
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/maskedName" }
            },
            "attributePath": {
              "description": "The attribute the values are in, with [] for every list element (stepResults[].observedDtmf). The offsets' pointers name the exact element.",
              "$ref": "#/$defs/maskedName"
            },
            "keyMasked": { "const": true },
            "planted": {
              "description": "The path is configured as planted test input (a test script's steps), not a leak.",
              "const": true
            }
          }
        },
        {
          "description": "One column of one table of an RDS or Aurora database (1.2): schema.table.column.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "engine", "dbType", "cluster", "database", "table", "column", "readBy"],
          "properties": {
            "type": { "const": "rds_column" },
            "engine": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
            "dbType": { "enum": ["cluster", "instance"] },
            "cluster": {
              "description": "The DB cluster or DB instance identifier.",
              "$ref": "#/$defs/maskedName"
            },
            "database": { "$ref": "#/$defs/maskedName" },
            "table": {
              "description": "schema.table (for MySQL, database.table).",
              "$ref": "#/$defs/maskedName"
            },
            "column": { "$ref": "#/$defs/maskedName" },
            "readBy": { "enum": ["snapshot_export", "data_api"] },
            "snapshotTime": {
              "description": "When the exported snapshot was taken. Not part of the finding id.",
              "type": "string",
              "format": "date-time"
            },
            "keyMasked": { "const": true }
          }
        },
        {
          "description": "One field of a store that is not S3, logs, DynamoDB or RDS (1.3): a warehouse column, a search index's document field, a stream's or queue's records, a parameter's or secret's value. 'service' names the product.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "service", "store", "readBy"],
          "properties": {
            "type": { "const": "store_field" },
            "service": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
            "store": {
              "description": "The cluster, workgroup, domain, stream, queue, parameter or secret.",
              "$ref": "#/$defs/maskedName"
            },
            "database": { "$ref": "#/$defs/maskedName" },
            "table": {
              "description": "schema.table for a warehouse, or the index, keyspace table or shard.",
              "$ref": "#/$defs/maskedName"
            },
            "field": {
              "description": "The column, the document's or record's field, or 'value'.",
              "$ref": "#/$defs/maskedName"
            },
            "readBy": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
            "snapshotTime": {
              "description": "When the copy read was taken, for a snapshot. Not part of the finding id.",
              "type": "string",
              "format": "date-time"
            },
            "subscription": { "$ref": "#/$defs/azureSubscription" },
            "resourceGroup": {
              "description": "The Azure resource group (1.6), masked like a key.",
              "$ref": "#/$defs/maskedName"
            },
            "resourceIdHash": { "$ref": "#/$defs/resourceIdHash" },
            "project": { "$ref": "#/$defs/gcpProject" },
            "resourceNameHash": { "$ref": "#/$defs/resourceNameHash" },
            "keyMasked": { "const": true }
          }
        },
        {
          "description": "One blob of an Azure Blob Storage or ADLS Gen2 container (1.6) and, for a table file, one column of it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "account", "container", "blob", "versionId", "resourceIdHash"],
          "properties": {
            "type": { "const": "blob_object" },
            "account": {
              "description": "The storage account, masked like a key.",
              "$ref": "#/$defs/maskedName"
            },
            "container": { "$ref": "#/$defs/maskedName" },
            "blob": {
              "description": "The blob's name (an ADLS Gen2 path), masked like a key.",
              "$ref": "#/$defs/maskedName"
            },
            "versionId": {
              "description": "The blob version read, or 'null' when versioning is off.",
              "type": "string",
              "maxLength": 1024
            },
            "column": {
              "description": "For a table file (Parquet, ORC, Avro): the column the values are in.",
              "$ref": "#/$defs/maskedName"
            },
            "subscription": { "$ref": "#/$defs/azureSubscription" },
            "resourceGroup": {
              "description": "The Azure resource group (1.6), masked like a key.",
              "$ref": "#/$defs/maskedName"
            },
            "resourceIdHash": { "$ref": "#/$defs/resourceIdHash" },
            "keyMasked": { "const": true }
          }
        },
        {
          "description": "One object of a Google Cloud Storage bucket (1.7) and, for a table file, one column of it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "bucket", "object", "generation", "resourceNameHash"],
          "properties": {
            "type": { "const": "gcs_object" },
            "bucket": {
              "description": "The bucket, masked like a key.",
              "$ref": "#/$defs/maskedName"
            },
            "object": {
              "description": "The object's name, masked like a key.",
              "$ref": "#/$defs/maskedName"
            },
            "generation": {
              "description": "The object generation read.",
              "type": "string",
              "pattern": "^(?:[0-9]{1,24}|null)$"
            },
            "column": {
              "description": "For a table file (Parquet, ORC, Avro): the column the values are in.",
              "$ref": "#/$defs/maskedName"
            },
            "project": { "$ref": "#/$defs/gcpProject" },
            "resourceNameHash": { "$ref": "#/$defs/resourceNameHash" },
            "keyMasked": { "const": true }
          }
        }
      ]
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0, "description": "UTF-16 code units" },
        "end": { "type": "integer", "minimum": 1 },
        "pointer": {
          "type": "string",
          "description": "RFC 6901 JSON Pointer to the string the offsets are in, for a JSON item."
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "resource", "format", "class", "severity", "count", "occurrences", "confidence",
        "confidenceCounts", "via", "offsets", "offsetsTruncated", "link", "firstSeenAt",
        "lastSeenAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "resource": { "$ref": "#/$defs/resource" },
        "format": {
          "enum": [
            "text", "csv", "json", "lambda_log", "connect_chat", "contact_lens", "lex_v2_log",
            "connect_flow_log", "dynamodb_item", "parquet", "orc", "avro", "sql", "block", "cql", "rdb",
            "kql"
          ]
        },
        "class": { "$ref": "#/$defs/class" },
        "severity": { "enum": ["high", "medium", "low"] },
        "count": { "type": "integer", "minimum": 0, "description": "Distinct values" },
        "occurrences": { "type": "integer", "minimum": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "confidenceCounts": {
          "type": "object",
          "propertyNames": { "enum": ["high", "medium", "low"] },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "via": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["prompt", "shape", "context"] }
        },
        "offsets": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/offset" } },
        "offsetsTruncated": { "type": "boolean" },
        "link": {
          "description": "A deep link into the account's own AWS console, (1.6) the resource's page in the Azure portal or (1.7) in the Google Cloud console; null when a name it would carry had to be masked.",
          "type": ["string", "null"],
          "pattern": "^https://(?:[a-z0-9-]+\\.console\\.aws\\.amazon\\.com/|portal\\.azure\\.com/|console\\.cloud\\.google\\.com/)"
        },
        "connect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contactId": { "type": "string", "maxLength": 64 },
            "instanceId": { "type": "string", "maxLength": 64 }
          }
        },
        "firstSeenAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "atRestEncryption": { "$ref": "#/$defs/atRestEncryption" },
        "atRestKeyHash": { "$ref": "#/$defs/atRestKeyHash" },
        "pciNote": {
          "description": "Guidance for the customer's QSA, never a verdict (1.5): 3.3.1 for any cvv finding, whatever the encryption; 3.5.1.2 for a card finding under storage-level encryption (service_managed or customer_managed_key).",
          "type": "object",
          "additionalProperties": false,
          "required": ["requirement", "guidance"],
          "properties": {
            "requirement": { "enum": ["3.3.1", "3.5.1.2"] },
            "guidance": { "type": "string", "maxLength": 400 }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "target", "listed", "eligible", "scanned", "sampledOut", "samplePercent",
        "partial", "unreadable", "bytesScanned", "skipped", "formats", "testValues",
        "suppressed", "redactionMarkers", "passComplete", "backlog", "error"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/storeKind" },
        "target": { "$ref": "#/$defs/maskedName" },
        "listed": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "scanned": { "type": "integer", "minimum": 0 },
        "sampledOut": { "type": "integer", "minimum": 0 },
        "samplePercent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "partial": { "type": "integer", "minimum": 0 },
        "unreadable": { "type": "integer", "minimum": 0 },
        "bytesScanned": { "type": "integer", "minimum": 0 },
        "skipped": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "audio", "video", "image", "document", "archive", "binary", "columnar",
              "archive_tier", "billed_plan"
            ]
          },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "formats": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "testValues": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "redactionMarkers": { "type": "integer", "minimum": 0 },
        "passComplete": { "type": "boolean" },
        "backlog": { "type": "boolean" },
        "error": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,80}$" },
        "kmsDenied": {
          "description": "Items not read because the scanner may not use their KMS key (1.2).",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "storeReason": {
      "enum": [
        "denied", "not_allowed", "self", "too_large", "unsupported", "unsupported_format",
        "kms_access", "access_denied", "lake_formation", "tags_unreadable", "budget", "error",
        "export_not_configured", "export_pending", "export_failed", "no_snapshot", "pitr_off",
        "read_not_configured", "paused", "no_grant", "vpc_only", "no_snapshot_export",
        "needs_task", "backup_copy", "archived", "live_queue", "redrive_would_change",
        "no_s3_destination", "in_memory", "no_read_path",
        "db_user_can_write", "grants_unverifiable", "driver_missing", "user_can_write",
        "archive_retrieval", "network", "needs_sas_export",
        "requester_pays", "row_level_policy", "authorized_view"
      ]
    },
    "discovery": {
      "description": "The run summary (1.2): every store discovered or named, including the ones not read and why. Present when discovery is on. In a multi-part event, 'stores' is split across the parts like 'findings'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stores", "storesTotal", "storesTruncated", "byStatus", "byReason", "listErrors"],
      "properties": {
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "origin", "status"],
            "properties": {
              "kind": { "$ref": "#/$defs/storeKind" },
              "name": { "$ref": "#/$defs/maskedName" },
              "nameMasked": { "const": true },
              "origin": { "enum": ["discovery", "config"] },
              "status": { "enum": ["scanned", "deferred", "skipped", "error", "pending"] },
              "reason": { "$ref": "#/$defs/storeReason" },
              "error": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$" },
              "sizeBytes": { "type": "integer", "minimum": 0 },
              "samplePercent": { "type": "integer", "minimum": 1, "maximum": 100 },
              "maxObjectsPerPrefix": { "type": "integer", "minimum": 1 },
              "gaps": {
                "type": "object",
                "propertyNames": { "enum": ["kmsDenied", "unreadable", "unsupportedFormat"] },
                "additionalProperties": { "type": "integer", "minimum": 1 }
              },
              "backlog": { "const": true },
              "logGroupClass": { "type": "string", "pattern": "^[A-Z_]{1,40}$" },
              "tableStatus": { "type": "string", "pattern": "^[A-Z_]{1,60}$" },
              "location": { "$ref": "#/$defs/maskedName" },
              "lakeFormation": { "const": true },
              "catalogObject": { "enum": ["resource_link", "view", "not_s3"] },
              "engine": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
              "dbType": { "enum": ["cluster", "instance"] },
              "snapshotTime": { "type": "string", "format": "date-time" },
              "readBy": { "enum": ["export", "data_api"] },
              "exportStatus": {
                "enum": ["starting", "in_progress", "canceling", "complete", "completed", "canceled", "failed"]
              },
              "pitr": { "const": false },
              "deployment": {
                "description": "Redshift: a provisioned cluster or a Serverless workgroup; OpenSearch: a managed domain or a Serverless collection (1.3).",
                "enum": [
                  "provisioned", "managed", "serverless", "instance_based", "elastic",
                  "replication_group", "cluster", "live_analytics", "influxdb"
                ]
              },
              "database": {
                "description": "The database a store is connected to by default (1.3).",
                "$ref": "#/$defs/maskedName"
              },
              "resource": {
                "description": "EBS: a volume (read through its latest snapshot) or the latest snapshot of a volume that no longer exists (1.3); SageMaker: a feature group or a notebook instance (1.5).",
                "enum": ["volume", "snapshot", "feature_group", "notebook_instance"]
              },
              "olderSnapshots": {
                "description": "EBS: earlier snapshots of the same volume, counted and not read (1.3).",
                "type": "integer",
                "minimum": 1
              },
              "recoveryPoints": {
                "description": "AWS Backup: the vault's recovery points by resource type (1.3).",
                "type": "object",
                "propertyNames": { "pattern": "^[A-Za-z0-9]{1,40}$" },
                "additionalProperties": { "type": "integer", "minimum": 0 }
              },
              "destinations": {
                "description": "Firehose: where the delivery stream delivers (1.3). Its S3 locations are read; Redshift and OpenSearch by their own kinds.",
                "type": "array",
                "items": {
                  "enum": ["S3", "Redshift", "OpenSearch", "Splunk", "HttpEndpoint", "Snowflake", "Iceberg"]
                }
              },
              "deadLetterQueue": {
                "description": "SQS: another queue's redrive policy points at this one (1.3).",
                "const": true
              },
              "approximateMessages": {
                "description": "SQS: ApproximateNumberOfMessages when listed (1.3).",
                "type": "integer",
                "minimum": 0
              },
              "snapshots": {
                "description": "ElastiCache and MemoryDB: the cache's snapshots, counted (1.3).",
                "type": "integer",
                "minimum": 0
              },
              "atRestEncryption": { "$ref": "#/$defs/atRestEncryption" },
              "atRestKeyHash": { "$ref": "#/$defs/atRestKeyHash" },
              "subscription": { "$ref": "#/$defs/azureSubscription" },
              "resourceGroup": {
                "description": "Azure (1.6): the store's resource group, masked like a key.",
                "$ref": "#/$defs/maskedName"
              },
              "resourceIdHash": { "$ref": "#/$defs/resourceIdHash" },
              "project": { "$ref": "#/$defs/gcpProject" },
              "resourceNameHash": { "$ref": "#/$defs/resourceNameHash" },
              "tableType": {
                "description": "BigQuery (1.7): the table's type (TABLE, VIEW, MATERIALIZED_VIEW, EXTERNAL, SNAPSHOT); only TABLE and SNAPSHOT are read.",
                "type": "string",
                "pattern": "^[A-Z_]{1,40}$"
              },
              "protectedColumns": {
                "description": "BigQuery (1.7): columns under a policy tag (column-level security), left out of the read.",
                "type": "integer",
                "minimum": 1
              },
              "hierarchicalNamespace": {
                "description": "Azure Storage (1.6): the account has the hierarchical namespace on (ADLS Gen2).",
                "const": true
              },
              "api": {
                "description": "Azure Cosmos DB (1.6): the account's API. Only sql (NoSQL) has an Entra data-plane read; the others are no_read_path, except a MongoDB vCore cluster.",
                "enum": ["sql", "mongodb", "cassandra", "gremlin", "table"]
              },
              "networkRestricted": {
                "description": "Azure (1.6): the store admits only selected networks or private endpoints; when the job is not among them, the store is the network gap.",
                "const": true
              },
              "writeGrants": {
                "description": "The databases runner (1.4): the write privileges the database user holds, by name, when the store is refused (db_user_can_write). Never a value.",
                "type": "array",
                "maxItems": 30,
                "items": { "type": "string", "pattern": "^[A-Za-z0-9_ .-]{1,60}$" }
              },
              "items": {
                "description": "SSM Parameter Store and Secrets Manager: the parameters or secrets listed (1.3).",
                "type": "integer",
                "minimum": 0
              },
              "itemTypes": {
                "description": "SSM: parameters by type (String, StringList, SecureString); Secrets Manager: secrets managed by another service or not (1.3).",
                "type": "object",
                "propertyNames": { "pattern": "^[A-Za-z]{1,20}$" },
                "additionalProperties": { "type": "integer", "minimum": 0 }
              },
              "excluded": {
                "description": "Parameters or secrets not read, by reason: the deny or allow rules, unreadable tags, or SecureString with SSM_DECRYPT off (1.3).",
                "type": "object",
                "propertyNames": {
                  "enum": ["denied", "not_allowed", "tags_unreadable", "secure_string", "self"]
                },
                "additionalProperties": { "type": "integer", "minimum": 1 }
              },
              "fileSystemType": {
                "description": "FSx: LUSTRE, WINDOWS, ONTAP or OPENZFS (1.3).",
                "type": "string",
                "pattern": "^[A-Z_]{0,40}$"
              },
              "eventCount": {
                "description": "An EventBridge archive: the events it holds (1.5).",
                "type": "integer",
                "minimum": 0
              },
              "retentionDays": {
                "description": "An EventBridge archive: how long it keeps events; 0 is indefinitely (1.5).",
                "type": "integer",
                "minimum": 0
              },
              "archives": {
                "description": "An S3 Glacier vault: the archives in it, as of its last inventory (1.5).",
                "type": "integer",
                "minimum": 0
              },
              "workflowType": {
                "description": "Step Functions (1.5): a Standard state machine (its history is read) or an Express one (no history in the service; reported).",
                "enum": ["standard", "express"]
              },
              "state": {
                "description": "The store's own state, when it is why the store was not read (1.3).",
                "type": "string",
                "pattern": "^[A-Za-z0-9_ -]{1,60}$"
              }
            }
          }
        },
        "storesTotal": { "type": "integer", "minimum": 0 },
        "storesTruncated": { "type": "boolean" },
        "byStatus": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byReason": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/storeReason" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "listErrors": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/storeKind" },
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$" }
        }
      }
    }
  }
}
