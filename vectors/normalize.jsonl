{"id":"oh-in-sentence","description":"\"Oh\" with no digit next to it is a word.","text":"Oh I see","normalized":"Oh I see","digitRuns":[]}
{"id":"double-triple","description":"\"double\" and \"triple\" repeat the next digit.","text":"double five triple oh seven","normalized":"550007","digitRuns":[[0,6,0,27]]}
